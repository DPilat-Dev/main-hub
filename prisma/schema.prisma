// Main Hub — Prisma schema
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin user(s). Auth is handled by Auth.js with a Credentials provider.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

enum Role {
  ADMIN
}

/// Blog posts, authored through the admin WYSIWYG editor.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @default("") // rich HTML from the editor
  coverImage  String?
  tags        String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  @@index([published, publishedAt])
}

/// Portfolio / project showcase entries.
model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String
  description     String   @default("") // rich HTML
  coverImage      String?
  tech            String[] @default([])
  liveUrl         String?
  repoUrl         String?
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([featured, sortOrder])
}

/// Private dashboard links (server, subdomains, tools). Admin-only.
model DashboardLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  category    String   @default("General")
  icon        String? // react-icons name, optional
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
}
