// Main Hub — Prisma schema
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app at runtime (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations. Locally this can be
  // the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

/// Admin user(s). Auth is handled by Auth.js with a Credentials provider.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

enum Role {
  ADMIN
}

/// Blog posts, authored through the admin WYSIWYG editor.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @default("") // rich HTML from the editor
  coverImage  String?
  tags        String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  @@index([published, publishedAt])
}

/// Portfolio / project showcase entries.
model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String
  description     String   @default("") // rich HTML
  coverImage      String?
  tech            String[] @default([])
  liveUrl         String?
  repoUrl         String?
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([featured, sortOrder])
}

/// Editable site settings (singleton row, id = 1). Falls back to code defaults.
model SiteSettings {
  id               Int      @id @default(1)
  name             String   @default("")
  role             String   @default("")
  tagline          String   @default("")
  intro            String   @default("")
  heroPhrases      String[] @default([])
  email            String   @default("")
  location         String   @default("")
  githubUrl        String   @default("")
  linkedinUrl      String   @default("")
  heroImage         String  @default("")
  heroImageShape    String  @default("square") // square | circle | portrait
  heroImagePosition String  @default("right") // left | right
  heroImageRing     Boolean @default(false)
  availableForWork  Boolean @default(true)
  updatedAt         DateTime @updatedAt
}

/// Private dashboard links (server, subdomains, tools). Admin-only.
model DashboardLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  category    String   @default("General")
  icon        String? // react-icons name, optional
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
}
