# ── Database ──────────────────────────────────────────────────
# Pooled connection (app runtime). On Vercel Postgres/Neon use the pooled URL.
DATABASE_URL="postgresql://hub:hub_dev_password@localhost:5442/main_hub?schema=public"
# Direct connection (migrations). Locally, same as DATABASE_URL. On Neon use the
# unpooled URL (host without "-pooler").
DIRECT_URL="postgresql://hub:hub_dev_password@localhost:5442/main_hub?schema=public"

# ── Auth.js ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-generated-secret-here"
AUTH_TRUST_HOST=true

# ── Admin bootstrap (used by `npm run db:seed`) ───────────────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="a-strong-password"
ADMIN_NAME="Your Name"

# ── Optional integrations ─────────────────────────────────────
# Higher GitHub API rate limit for the "On GitHub" section (optional).
# GITHUB_TOKEN="ghp_..."
# Live homelab status feed (see scripts/homelab-status). Without it, the
# Homelab section shows a static "self-hosted on Proxmox" card.
# HOMELAB_STATUS_URL="https://status.yourdomain.com"
# HOMELAB_STATUS_TOKEN="optional-shared-secret"
